# Copia este fichero a .env y rellena las claves. .env está en .gitignore.

# Obligatoria: https://console.groq.com/keys
GROQ_API_KEY=

# Opcional. Respaldo cuando Groq agota la cuota diaria.
# OJO: el tier gratis de Gemini entrena con lo que se le manda. Vale para esta
# demo (el corpus es BOE, texto público); NO vale para documentos de cliente.
GEMINI_API_KEY=

# Modelo de embeddings: minilm (rápido) | mpnet | e5 (el que mejor mide)
RAG_MODEL=minilm
